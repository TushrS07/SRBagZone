# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/srbagzone

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

APP_ENV=development

# Background jobs — Upstash Redis (rediss://...). Leave blank to send inline.
# Set the SAME value on both the web service and the background worker.
REDIS_URL=

# Email — Brevo transactional API
BREVO_API_KEY=
EMAIL_FROM=noreply@srbagzone.com
EMAIL_FROM_NAME=SR Bagz Zone

# Where admin alerts (new order / payment / inquiry) are sent
ADMIN_EMAIL=

# OTP lifetime (minutes)
OTP_TTL_MINUTES=10
